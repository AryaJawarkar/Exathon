# Copy to .env and adjust for your Exasol Personal instance.
# Defaults match the local Exasol docker-db container in docker-compose.yml.

EXA_DSN=localhost:8563
EXA_USER=sys
EXA_PASSWORD=exasol
EXA_SCHEMA=OMNI

# Synthetic data volume (knobs for the generator)
SEED=42
N_CUSTOMERS=3000
N_PRODUCTS=250
N_DAYS=540
